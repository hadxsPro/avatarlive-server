{
  "name": "avatarlive",
  "version": "0.1.0",
  "description": "Remplacement webcam en temps réel pour streamers via OBS",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build": "electron-builder --win"
  },
  "dependencies": {
    "@elgato-stream-deck/node": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.0",
    "express": "^5.2.1",
    "node-global-key-listener": "^0.2.0",
    "obs-websocket-js": "^5.0.5",
    "stripe": "^22.0.0",
    "tmi.js": "^1.8.5"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.0.0"
  },
  "build": {
    "appId": "com.avatarlive.app",
    "productName": "AvatarLive",
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    }
